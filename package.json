{
  "name": "codescrubber",
  "displayName": "Code-Scrubber",
  "repository": {
    "url": "https://github.com/twilight0963/code-scrubber"
  },
  "description": "Code privacy and credential leak helper.",
  "version": "2.0.3",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "bin": {
    "code-scrubber": "./bin/code-scrubber.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "twilight0963.codescrubber.showCredentialPrompt",
        "title": "Code Scrubber: Show Credential Security Prompt",
        "category": "Code Scrubber"
      },
      {
        "command": "twilight0963.codescrubber.encryptDotenv",
        "title": "Encrypt .env file",
        "category": "Code Scrubber",
        "icon": "$(lock)"
      },
      {
        "command": "twilight0963.codescrubber.decryptDotenv",
        "title": "Decrypt .env.enc file",
        "category": "Code Scrubber",
        "icon": "$(key)"
      },
      {
        "command": "twilight0963.codescrubber.installHook",
        "title": "Install pre-commit hook",
        "category": "Code Scrubber",
        "icon": "$(shield)"
      },
      {
        "command": "twilight0963.codescrubber.removeHook",
        "title": "Remove pre-commit hook",
        "category": "Code Scrubber"
      },
      {
        "command": "twilight0963.codescrubber.scanRepository",
        "title": "Scan repository for secrets",
        "category": "Code Scrubber",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "twilight0963.codescrubber.scanRepository",
          "group": "navigation",
          "when": "scmProvider == git"
        },
        {
          "command": "twilight0963.codescrubber.encryptDotenv",
          "group": "navigation",
          "when": "config.twilight0963.codescrubber.enableEncryption"
        },
        {
          "command": "twilight0963.codescrubber.decryptDotenv",
          "group": "navigation",
          "when": "config.twilight0963.codescrubber.enableEncryption"
        }
      ]
    },
    "configuration": {
      "title": "Code Scrubber",
      "properties": {
        "twilight0963.codescrubber.enableEncryption": {
          "type": "boolean",
          "default": true,
          "description": "Enable the 'Encrypt .env file' button in the Source Control menu."
        },
        "twilight0963.codescrubber.preCommitHook": {
          "type": "string",
          "enum": [
            "always",
            "prompt",
            "never"
          ],
          "enumDescriptions": [
            "Install the hook automatically in every repository that doesn't have one, then scan the repository.",
            "Ask once per repository when it is opened or initialized.",
            "Never install or offer the hook automatically (the commands still work)."
          ],
          "default": "always",
          "description": "Install a pre-commit hook that blocks commits adding hardcoded secrets."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test:unit": "node --test \"core/test/**/*.test.js\" \"cli/test/**/*.test.js\"",
    "pretest": "npm run lint && npm run test:unit",
    "test": "vscode-test",
    "scan": "node bin/code-scrubber.js scan",
    "package": "mkdir -p build && vsce package --out build/"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.3.0",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.0.0",
    "globals": "^17.12.0"
  },
  "dependencies": {
    "is-gibberish": "^0.1.0"
  },
  "publisher": "twilight0963",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  }
}
