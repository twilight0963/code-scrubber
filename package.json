{
  "name": "codescrubber",
  "displayName": "Code-Scrubber",
  "repository": {
    "url": "https://github.com/twilight0963/code-scrubber"
  },
  "description": "Code privacy and credential leak helper.",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "twilight0963.codescrubber.showCredentialPrompt",
        "title": "Code Scrubber: Show Credential Security Prompt",
        "category": "Code Scrubber"
      },
      {
        "command": "twilight0963.codescrubber.encryptDotenv",
        "title": "Encrypt .env file",
        "category": "Code Scrubber",
        "icon": "$(lock)"
      },
      {
        "command": "twilight0963.codescrubber.decryptDotenv",
        "title": "Decrypt .env.enc file",
        "category": "Code Scrubber",
        "icon": "$(key)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "twilight0963.codescrubber.encryptDotenv",
          "group": "navigation",
          "when": "config.twilight0963.codescrubber.enableEncryption"
        },
        {
          "command": "twilight0963.codescrubber.decryptDotenv",
          "group": "navigation",
          "when": "config.twilight0963.codescrubber.enableEncryption"
        }
      ]
    },
    "configuration": {
      "title": "Code Scrubber",
      "properties": {
        "twilight0963.codescrubber.enableEncryption": {
          "type": "boolean",
          "default": true,
          "description": "Enable the 'Encrypt .env file' button in the Source Control menu."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.3.0",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.0.0"
  },
  "dependencies": {
    "is-gibberish": "^0.1.0"
  },
  "publisher": "twilight0963"
}
